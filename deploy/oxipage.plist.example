# [DEPRECATED] Oxipage v2 is a Static Site Generator — this file is retained for reference only.
# The public site no longer needs a runtime server. Use 'oxipage build && oxipage deploy'
# to deploy to GitHub Pages, Cloudflare Pages, or Netlify.
# This file may still be useful for running the local management server (oxipage serve).
# See docs/superpowers/specs/2026-07-28-static-site-generator-design.md for details.

<?xml version="1.0" encoding="UTF-8"?>
<!-- oxipage — macOS launchd plist 예시 (doc/05 §5.2).
     설치: cp deploy/oxipage.plist.example ~/Library/LaunchAgents/dev.oxipage.server.plist
           launchctl load ~/Library/LaunchAgents/dev.oxipage.server.plist
     시크릿(OXIPAGE_ADMIN_TOKEN 등)은 plist에 평문 적지 말고 launchctl setenv 또는
     별도 secrets 파일 source로 주입. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.oxipage.server</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/oxipage-server</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/srv/oxipage</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>RUST_LOG</key>
        <string>info</string>
        <key>OXIPAGE_CONFIG</key>
        <string>/srv/oxipage/oxipage.toml</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>StandardOutPath</key>
    <string>/srv/oxipage/logs/stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/srv/oxipage/logs/stderr.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
