# Oxipage 배포 매니페스트 (doc/05 §5.7, doc/06 Phase 5).
# compose-spec 유사 키. 단일 진실 소스 — (a) 바이너리 직접 기동(launchd/systemd)
# 또는 (b) container run 중 택일.
#
# 이 파일 자체는 실행되지 않는 선언. 향후 `oxipage deploy`가 읽어 적용.

[site]
# 실제 배포 시 사용자가 덮어쓴다.
name = "Oxipage"
base_url = "https://example.com"
default_lang = "ko"
languages = ["ko", "en"]

[server]
host = "0.0.0.0"          # 컨테이너/리버스 프록시 후단이면 0.0.0.0
port = 8787
data_dir = "/srv/oxipage/data"

[extensions]
# 비어 있으면 전부 활성화.
enabled = []

[integrations]
# github_username = "yourname"
# tmdb_api_key_env = "OXIPAGE_TMDB_KEY"
# aladin_ttbkey_env = "OXIPAGE_ALADIN_TTBKEY"

[lobby]
default_mode = "grid"

[deploy]
# "binary" | "container" — 어느 경로로 기동할지.
mode = "binary"

[deploy.binary]
# launchd(plist) 또는 systemd(unit) 예시는 deploy/*.example 참조.
method = "launchd"        # macOS: launchd, Linux: systemd
binary_path = "/usr/local/bin/oxipage-core"

[deploy.container]
# Apple container build / docker build 공통 사용.
image = "oxipage:latest"
# 컨테이너 빌드는 deploy/Dockerfile 사용.
build_context = "."
dockerfile = "deploy/Dockerfile"

[deploy.tls]
# Cloudflare Tunnel이 TLS 종료를 담당하면 호스트 Caddy는 평문 리버스 프록시.
mode = "cloudflare_tunnel"
# tunnel_token은 별도 secrets에서 주입(cloudflared service).
caddy_config = "deploy/Caddyfile.example"
